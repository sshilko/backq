parameters:
    level: 0
    tmpDir: tmp
    paths:
        - ../src
    bootstrapFiles:
        - ../vendor/autoload.php
    excludePaths:
        - ../example/*
    parallel:
        maximumNumberOfProcesses: 4
        processTimeout: 300.0
