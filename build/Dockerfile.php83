FROM library/composer:2 AS composer
FROM library/php:8.3-cli
LABEL author='Sergei Shilko <contact@sshilko.com>'

ENV DEBIAN_FRONTEND noninteractive

# /usr/share/man/man1 needs to be created before installing openjdk-11-jre lest it will fail
# https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=863199#23
RUN mkdir -p /usr/share/man/man1

# https://wiki.ubuntu.com/ReducingDiskFootprint
# Configure dpkg excludes
RUN echo 'path-exclude /usr/share/doc/*' >> /etc/dpkg/dpkg.cfg.d/01_excludes
RUN echo 'path-include /usr/share/doc/*/copyright' >> /etc/dpkg/dpkg.cfg.d/01_excludes
RUN echo 'path-exclude /usr/share/man/*' >> /etc/dpkg/dpkg.cfg.d/01_excludes
RUN echo 'path-exclude /usr/share/groff/*' >> /etc/dpkg/dpkg.cfg.d/01_excludes
RUN echo 'path-exclude /usr/share/info/*' >> /etc/dpkg/dpkg.cfg.d/01_excludes
RUN echo 'path-exclude /usr/share/locale/*' >> /etc/dpkg/dpkg.cfg.d/01_excludes
RUN echo 'path-exclude /usr/share/lintian/*' >> /etc/dpkg/dpkg.cfg.d/01_excludes
RUN echo 'path-exclude /usr/share/linda/*' >> /etc/dpkg/dpkg.cfg.d/01_excludes
RUN cat /etc/dpkg/dpkg.cfg.d/01_excludes

# Configure APT recommendations and clean up existing locales
RUN echo 'APT::Install-Recommends "0";' > /etc/apt/apt.conf.d/no-recommends
RUN find /usr/share/locale -maxdepth 1 -mindepth 1 ! -name 'en' | xargs rm -rf

# Package installation and PHP extension setup
RUN apt-get update
RUN docker-php-ext-install -j$(nproc) mysqli
RUN docker-php-ext-install -j$(nproc) pcntl
RUN apt-get install -y --no-install-recommends \
    unzip \
    python3-pip \
    pre-commit \
    locales \
    netcat-traditional \
    git

# Package manager cleanup
RUN apt-get clean
RUN apt-get -y autoremove
RUN rm -rf /var/lib/{apt,cache,log}/
RUN rm -rf /tmp/* /var/tmp/*

# System configuration (Limits, Locales, Timezone)
RUN echo "* hard nofile 524280" >> /etc/security/limits.conf
RUN echo "* soft nofile 262140" >> /etc/security/limits.conf
RUN echo 'en_US.UTF-8 UTF-8' > /etc/locale.gen
RUN /usr/sbin/locale-gen
RUN echo "TZ=Etc/UTC" >> /etc/environment

ENV LANG "en_US.UTF-8"
ENV LC_ALL "en_US.UTF-8"
ENV TZ "Etc/UTC"

HEALTHCHECK --interval=10s --timeout=1s --retries=2 --start-period=5s CMD /usr/local/bin/php -v || exit 1
WORKDIR /app
COPY --from=composer /usr/bin/composer /usr/bin/composer

#https://www.phpdoc.org
ADD https://phpdoc.org/phpDocumentor.phar /usr/bin/phpdoc
RUN chmod +x /usr/bin/phpdoc

#phan/phan php-ast dependency
#https://github.com/mlocati/docker-php-extension-installer
#backq redis adapter uses ext-redis (illuminate phpredis driver)
COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/
RUN install-php-extensions ast redis

#phpunit coverage requirement
RUN mkdir /root/tmp && pear config-set temp_dir /root/tmp && install-php-extensions xdebug
ENV XDEBUG_MODE "coverage"

RUN docker-php-ext-enable opcache

RUN git config --global --add safe.directory /app

STOPSIGNAL SIGINT
ENTRYPOINT [ "/bin/bash" ]
CMD ["-c", "trap exit INT; while sleep 1; do sleep 1; done;"]