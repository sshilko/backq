{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "VisualEditor0",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetShardIterator",
        "dynamodb:DescribeStream",
        "dynamodb:GetRecords"
      ],
      "Resource": [
        "arn:aws:dynamodb:{region}:{account_id}:table/{fast-queue-name}/stream/{stream_label}",
        "arn:aws:dynamodb:{region}:{account_id}:table/{slow-queue-name}/stream/{stream_label}"
      ]
    },
    {
      "Sid": "VisualEditor1",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ListStreams"
      ],
      "Resource": [
        "arn:aws:dynamodb:{region}:{account_id}:table/{fast-queue-name}/stream/*",
        "arn:aws:dynamodb:{region}:{account_id}:table/{slow-queue-name}/stream/*"
      ]
    },
    {
      "Sid": "VisualEditor2",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": [
        "arn:aws:sqs:{region}:{account_id}:{fast-queue-name}",
        "arn:aws:sqs:{region}:{account_id}:{slow-queue-name}"
      ]
    },
    {
      "Sid": "VisualEditor3",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*"
    }
  ]
}